        <mxCell id="e4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#52616B;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="d-sc2" target="d-sc1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82B366;endArrow=block;endFill=1;fontSize=12;fontColor=#38761D;" edge="1" parent="1" source="d-sc1" target="respin"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#52616B;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="d-sc1" target="no-trigger"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#52616B;endArrow=block;endFill=1;" edge="1" parent="1" source="fs" target="fs-rule"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#52616B;endArrow=block;endFill=1;" edge="1" parent="1" source="fs-rule" target="fs-cap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#52616B;endArrow=block;endFill=1;" edge="1" parent="1" source="respin" target="new-sc1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82B366;endArrow=block;endFill=1;fontSize=12;fontColor=#38761D;" edge="1" parent="1" source="new-sc1" target="add-one"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#52616B;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="new-sc1" target="dec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#52616B;endArrow=block;endFill=1;" edge="1" parent="1" source="dec" target="has-left"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="是：继续 Respin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82B366;endArrow=block;endFill=1;fontSize=12;fontColor=#38761D;" edge="1" parent="1" source="has-left" target="respin"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="否：结束" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#52616B;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="has-left" target="respin-cap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9673A6;endArrow=block;endFill=1;" edge="1" parent="1" source="buy" target="buy-rule"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="进入同一套 FS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9673A6;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#6A4C78;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="buy-rule" target="fs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="682" y="710"/><mxPoint x="840" y="710"/><mxPoint x="840" y="208"/></Array></mxGeometry></mxCell>

        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#52616B;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fs-cap" target="return"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1365" y="280"/><mxPoint x="1355" y="280"/></Array></mxGeometry></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#52616B;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="no-trigger" target="return"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="760"/><mxPoint x="1355" y="760"/></Array></mxGeometry></mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#52616B;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="respin-cap" target="return"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="最多 5 次" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82B366;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#38761D;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="add-one" target="respin"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1332" y="285"/><mxPoint x="840" y="285"/></Array></mxGeometry></mxCell>
